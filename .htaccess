# STARNAUTS — 확장자 없는 URL
#
# 링크는 전부 확장자 없이 바꿨지만, 옛 주소로 들어오는 요청과 직접 입력을 위해
# 서버에서도 정리한다. Hostinger 는 LiteSpeed 라 .htaccess 를 읽는다.
#
# 규칙 순서가 중요하다. 홈과 index 를 먼저 처리하지 않으면 아래 일반 규칙이
# /Starnauts%20Home 같은 어중간한 주소로 301 을 걸어버린다.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# 수집한 리드는 개인정보다. 웹에서 직접 열리지 않게 막는다 (lead.php 만 쓴다).
RewriteRule ^leads(/|$) - [F,L]

# 1) 옛 홈 → /
RewriteCond %{THE_REQUEST} \s/+Starnauts(%20|\+|\s)Home\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) /index.html → /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 3) 나머지 .html 요청 → 확장자 없는 주소로 301
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4) 확장자 없는 주소를 실제 .html 파일로 내부 매핑 (주소창은 그대로)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

ErrorDocument 404 /404.html

# 보안 헤더. preload 는 넣지 않는다 — 등록하면 되돌리기 어렵다.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 정적 자원 캐시. HTML 은 짧게 둬서 수정이 바로 반영되게 한다.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
